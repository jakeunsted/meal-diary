{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", "dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      "passThroughEnv": [
        "DEV_DB_NAME",
        "DEV_DB_USER",
        "DEV_DB_PASSWORD",
        "DEV_DB_HOST",
        "DEV_DB_PORT",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET"
      ]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
