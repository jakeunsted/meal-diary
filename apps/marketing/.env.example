# Public marketing site origin (used for sitemap, canonical, Open Graph)
SITE_URL=https://mealdiary.co.uk

# Logged-in product app
APP_URL=https://app.mealdiary.co.uk

# Optional overrides (default to APP_URL paths)
# PLANS_URL=https://app.mealdiary.co.uk/plans
# PRIVACY_URL=https://app.mealdiary.co.uk/privacy
# TERMS_URL=https://app.mealdiary.co.uk/terms

# Analytics (same project / measurement ID as product web)
# GA4 is dormant unless set; product analytics still gated on Silktide Analytics consent
GA_MEASUREMENT_ID=

# PostHog — error tracking under Essential; product analytics under Analytics consent
POSTHOG_PUBLIC_KEY=
POSTHOG_HOST=https://prxhg.mealdiary.co.uk
