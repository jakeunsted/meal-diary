{
  "expo": {
    "name": "Meal Diary",
    "slug": "meal-diary",
    "version": "1.8.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mealdiary",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.co.mealdiary.app",
      "buildNumber": "24"
    },
    "android": {
      "package": "uk.co.mealdiary.app",
      "versionCode": 24,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "uk.co.mealdiary.app",
              "path": "/oauthredirect"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1A1F2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1A1F2E"
        }
      ],
      "expo-sharing",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.801654137636-35uovt5s62nm5caj1o1pfu8t1otflo9c"
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-sqlite",
      "expo-status-bar",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          },
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withR8Optimize",
      [
        "posthog-react-native/expo",
        {
          "dotenvFile": ".env",
          "uploadNativeSymbols": true,
          "skipOnConflict": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "43c451d2-77d6-4296-8427-cce130c61d5c"
      }
    }
  }
}
