# Environment files (Expo NODE_ENV):
#   development → .env.development.local > .env.local > .env.development > .env
#   production  → .env.production.local > .env.local > .env.production > .env
#
# Put machine-specific overrides in .env / .env.local (gitignored).
# Do not put API/web URLs in .env.local if you ship local release AABs —
# .env.local outranks .env.production. Release builds still rewrite local
# hosts to production in constants/env.ts.
#
# Shared / local defaults. Mode-specific URLs live in:
#   .env.development  (emulator API + dev web)
#   .env.production   (https://api.mealdiary.co.uk + https://app.mealdiary.co.uk)
#
# Android emulator: http://10.0.2.2:3001
# Physical device: http://<your-lan-ip>:3001
# Expo web (localhost): http://localhost:3001
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001

# Public web app URL — used for invite links, legal pages, and plans
EXPO_PUBLIC_WEB_URL=https://dev-app.mealdiary.co.uk

# Optional: set when using nginx at dev-app.mealdiary.co.uk (see README)
# EXPO_PACKAGER_PROXY_URL=https://dev-app.mealdiary.co.uk

# Google Sign-In (optional — same Web OAuth client ID as API GOOGLE_CLIENT_ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Android OAuth client ID for com.mealdiary.app (recommended for native sign-in)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Optional: override Google OAuth redirect URI (must match Google Cloud Console exactly)
# EXPO_PUBLIC_GOOGLE_REDIRECT_URI=https://dev-app.mealdiary.co.uk

# PostHog (optional — analytics + feature flags; leave empty to disable)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://prxhg.mealdiary.co.uk

# RevenueCat (in-app subscriptions — required for native purchase flow)
# Public SDK keys from RevenueCat dashboard → Project → API keys
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
