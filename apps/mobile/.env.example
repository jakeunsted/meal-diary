# Expo does not load this file. Copy the keys into the two gitignored files:
#
#   .env.development   expo start (NODE_ENV=development)
#   .env.production    Play builds and ./gradlew bundleRelease (NODE_ENV=production)
#
# Do not create .env or .env.local. Expo also loads .env.local for production
# builds, and those values override .env.production.
#
# EXPO_PUBLIC_API_URL
#   Android emulator:  http://10.0.2.2:3001
#   Physical device:   http://<your-lan-ip>:3001
#   Browser:           http://localhost:3001
#   Production:        https://api.mealdiary.co.uk
#
# EXPO_PUBLIC_WEB_URL
#   Development:       https://dev-app.mealdiary.co.uk
#   Production:        https://app.mealdiary.co.uk

EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WEB_URL=

# Web OAuth client. Must match GOOGLE_CLIENT_ID on the API for that environment.
# Use a different web client in .env.development and .env.production.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Android OAuth client for uk.co.mealdiary.app.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# iOS OAuth client. Leave unset to fall back to the web client ID.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# PostHog project token (public). Leave the key empty to disable PostHog.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://prxhg.mealdiary.co.uk

# Release symbol upload. Put these in .env.production only.
# POSTHOG_CLI_API_KEY is a personal key with error-tracking write, not the project token above.
# POSTHOG_CLI_API_KEY=
# POSTHOG_CLI_PROJECT_ID=
# POSTHOG_CLI_HOST=https://eu.posthog.com

# RevenueCat public SDK keys (dashboard → Project → API keys).
# Without them, upgrade buttons open the web plans page.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
