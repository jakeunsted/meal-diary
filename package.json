{
  "name": "meal-diary",
  "private": true,
  "workspaces": [
    "api",
    "frontend",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=meal-diary-api --filter=nuxt-app",
    "dev:mobile": "npm run dev --workspace=meal-diary-mobile",
    "dev:mobile:proxy": "npm run dev:proxy --workspace=meal-diary-mobile",
    "dev:mobile:proxy:https": "npm run dev:proxy:https --workspace=meal-diary-mobile",
    "dev:mobile:android": "npm run dev:android --workspace=meal-diary-mobile",
    "dev:mobile:tunnel": "npm run dev:tunnel --workspace=meal-diary-mobile",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=./frontend",
    "bump-mobile-version": "node scripts/bump-mobile-version.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "vue-i18n": "^10.0.8"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "tmp": "0.2.7",
    "turbo": "^2.10.12",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=26.3.0"
  },
  "overrides": {
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "tar": "7.5.22",
    "browserslist": "4.28.9",
    "postcss": "8.5.28",
    "qs": "6.16.0",
    "systeminformation": "5.33.10",
    "dompurify": "3.4.15",
    "baseline-browser-mapping": "2.11.22",
    "@nuxt/devtools": "3.4.2",
    "js-yaml": "4.3.2",
    "body-parser": "2.3.0",
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/propagator-jaeger": "2.11.0",
    "@xmldom/xmldom": "0.9.12"
  },
  "packageManager": "npm@11.16.0"
}
